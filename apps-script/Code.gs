function completedSpotOwner_(ss,station,spot,vanId){const completed=completedVanIdsToday_(ss),exclude=String(vanId||''),van=rows_(ss.getSheetByName(APP.SHEETS.vans)).find(x=>String(x.VanID)!==exclude&&x.CurrentStation===station&&x.CurrentSpot===spot&&completed.has(String(x.VanID)));if(van)return van;const row=rows_(ss.getSheetByName(APP.SHEETS.spots)).find(x=>x.Station===station&&x.Spot===spot),occupied=row&&String(row.OccupiedByVanID||'');return occupied&&occupied!==exclude&&completed.has(occupied)?{VanID:occupied}:null}
function available_(ss,station,vanId,email){const now=Date.now(),exclude=String(vanId||''),completed=completedVanIdsToday_(ss),completedSpots=new Set(rows_(ss.getSheetByName(APP.SHEETS.vans)).filter(x=>String(x.VanID)!==exclude&&x.CurrentStation===station&&completed.has(String(x.VanID))).map(x=>String(x.CurrentSpot||''))),spots=rows_(ss.getSheetByName(APP.SHEETS.spots));spots.filter(x=>x.Station===station&&String(x.OccupiedByVanID||'')!==exclude&&completed.has(String(x.OccupiedByVanID||''))).forEach(x=>completedSpots.add(String(x.Spot)));return spots.filter(x=>yes_(x.Active)&&x.Station===station&&!completedSpots.has(String(x.Spot))&&(!x.ReservedByEmail||norm_(x.ReservedByEmail)===norm_(email)||new Date(x.ReservationExpires||0).getTime()<now))}
function reserve_(ss,sp,i,email){expire_(ss);const x=find_(ss,APP.SHEETS.spots,'SpotID',sp.SpotID);if(completedSpotOwner_(ss,x.Station,x.Spot,i.VanID))throw new Error('Spot is occupied by a van inspected today.');if(x.ReservedByEmail&&norm_(x.ReservedByEmail)!==norm_(email)&&new Date(x.ReservationExpires).getTime()>Date.now())throw new Error('Spot was reserved by another user.');update_(ss.getSheetByName(APP.SHEETS.spots),'SpotID',x.SpotID,{ReservedByEmail:email,ReservationExpires:new Date(Date.now()+1800000),UpdatedAt:new Date()})}
function displacePendingSpot_(ss,station,spot,vanId){const completed=completedVanIdsToday_(ss),vans=rows_(ss.getSheetByName(APP.SHEETS.vans)).filter(x=>String(x.VanID)!==String(vanId)&&x.CurrentStation===station&&x.CurrentSpot===spot&&!completed.has(String(x.VanID)));vans.forEach(v=>{update_(ss.getSheetByName(APP.SHEETS.vans),'VanID',v.VanID,{CurrentSpot:'',UpdatedAt:new Date()});rows_(ss.getSheetByName(APP.SHEETS.inspections)).filter(i=>String(i.VanID)===String(v.VanID)&&i.InspectionState==='In Progress'&&i.Station===station&&i.Spot===spot).forEach(i=>update_(ss.getSheetByName(APP.SHEETS.inspections),'InspectionID',i.InspectionID,{Spot:''}))})}
function release_(ss,i,email){const sh=ss.getSheetByName(APP.SHEETS.spots);rows_(sh).filter(x=>norm_(x.ReservedByEmail)===norm_(email)&&x.Spot===i.Spot).forEach(x=>update_(sh,'SpotID',x.SpotID,{ReservedByEmail:'',ReservationExpires:'',UpdatedAt:new Date()}))}
function expire_(ss){const sh=ss.getSheetByName(APP.SHEETS.spots);rows_(sh).filter(x=>x.ReservedByEmail&&new Date(x.ReservationExpires||0).getTime()<Date.now()).forEach(x=>update_(sh,'SpotID',x.SpotID,{ReservedByEmail:'',ReservationExpires:'',UpdatedAt:new Date()}))}
function ensureInspectionCleanupTrigger_(){const p=PropertiesService.getScriptProperties(),key='CLOSING_INSPECTION_CLEANUP_TRIGGER';if(p.getProperty(key))return true;try{const name='cleanupOldInspections',existing=ScriptApp.getProjectTriggers().find(t=>t.getHandlerFunction()===name);if(!existing)ScriptApp.newTrigger(name).timeBased().atHour(3).nearMinute(15).everyDays(1).create();p.setProperty(key,'installed');return true}catch(e){return false}}
function cleanupOldInspections(){return lock_(()=>{const ss=db_(),inspectionSheet=ss.getSheetByName(APP.SHEETS.inspections),photoSheet=ss.getSheetByName(APP.SHEETS.photos),damageSheet=ss.getSheetByName(APP.SHEETS.damages);if(!inspectionSheet||inspectionSheet.getLastRow()<2)return{deletedInspections:0,deletedPhotos:0,deletedDamages:0};const inspections=rows_(inspectionSheet).filter(x=>x.InspectionState==='Completed'),byVan={};inspections.forEach(x=>(byVan[String(x.VanID)]||(byVan[String(x.VanID)]=[])).push(x));const removeIds=new Set();Object.keys(byVan).forEach(vanId=>byVan[vanId].sort(desc_).slice(10).forEach(x=>removeIds.add(String(x.InspectionID))));if(!removeIds.size)return{deletedInspections:0,deletedPhotos:0,deletedDamages:0};const photos=rows_(photoSheet).filter(x=>removeIds.has(String(x.InspectionID)));photos.forEach(x=>{try{if(x.FileID)DriveApp.getFileById(x.FileID).setTrashed(true)}catch(e){}});const deleteMatching=(sh,header,ids)=>{if(!sh||sh.getLastRow()<2)return 0;const values=sh.getDataRange().getValues(),headers=values[0].map(String),col=headers.indexOf(header);if(col<0)return 0;let count=0;for(let r=values.length-1;r>=1;r--)if(ids.has(String(values[r][col]))){sh.deleteRow(r+1);count++}return count},deletedPhotos=deleteMatching(photoSheet,'InspectionID',removeIds),deletedDamages=deleteMatching(damageSheet,'InspectionID',removeIds),deletedInspections=deleteMatching(inspectionSheet,'InspectionID',removeIds);return{deletedInspections,deletedPhotos,deletedDamages}})}
function expireOldInspections_(ss){const sh=ss.getSheetByName(APP.SHEETS.inspections);if(!sh||sh.getLastRow()<2)return;const data=sh.getDataRange().getValues(),headers=data[0].map(String),stateCol=headers.indexOf('InspectionState'),dateCol=headers.indexOf('InspectionDate'),startedCol=headers.indexOf('StartedAt'),emailCol=headers.indexOf('UserEmail'),spotCol=headers.indexOf('Spot'),today=day_(),now=Date.now();if(stateCol<0)return;for(let r=1;r<data.length;r++){if(String(data[r][stateCol])!=='In Progress')continue;const date=dateCol>=0?data[r][dateCol]:startedCol>=0?data[r][startedCol]:'',started=startedCol>=0?new Date(data[r][startedCol]).getTime():0,expired=storedDay_(date)!==today||!started||now-started>=APP.INSPECTION_TIMEOUT_MS;if(!expired)continue;sh.getRange(r+1,stateCol+1).setValue('Cancelled');if(emailCol>=0&&spotCol>=0)release_(ss,{Spot:data[r][spotCol]},data[r][emailCol])}}
function clearVanSpot_(ss,id){const sh=ss.getSheetByName(APP.SHEETS.spots);rows_(sh).filter(x=>String(x.OccupiedByVanID)===String(id)).forEach(x=>update_(sh,'SpotID',x.SpotID,{OccupiedByVanID:'',UpdatedAt:new Date()}))}
function occupy_(ss,station,name,id){const sh=ss.getSheetByName(APP.SHEETS.spots),x=rows_(sh).find(r=>r.Station===station&&String(r.Spot)===String(name));if(!x)throw new Error('Spot not found.');update_(sh,'SpotID',x.SpotID,{OccupiedByVanID:id,ReservedByEmail:'',ReservationExpires:'',UpdatedAt:new Date()})}
function previous_(ss,vanId,part,current){const ins=rows_(ss.getSheetByName(APP.SHEETS.inspections)).filter(x=>String(x.VanID)===String(vanId)&&x.InspectionState==='Completed'&&String(x.InspectionID)!==String(current)).sort(desc_),ph=rows_(ss.getSheetByName(APP.SHEETS.photos));for(const i of ins){const p=ph.find(x=>String(x.InspectionID)===String(i.InspectionID)&&x.Part===part);if(p)return p}return null}
function savePhoto_(data,i,part,id){const mime=(data.match(/^data:(image\/[^;]+);base64,/)||[])[1]||'image/jpeg',blob=Utilities.newBlob(Utilities.base64Decode(data.split(',')[1]),mime,part.replace(/\s+/g,'_')+'_'+id+'.jpg'),root=photoRoot_(),d=folder_(root,day_()),v=folder_(d,String(i.VanNumber||i.VanID));return v.createFile(blob)}
function photoRoot_(){const p=PropertiesService.getScriptProperties(),key='CLOSING_PHOTO_FOLDER_ID',saved=p.getProperty(key);if(saved){try{return DriveApp.getFolderById(saved)}catch(e){p.deleteProperty(key)}}const name='Closing Van Inspection Photos',it=DriveApp.getFoldersByName(name),folder=it.hasNext()?it.next():DriveApp.createFolder(name);p.setProperty(key,folder.getId());return folder}
function folder_(p,n){const it=p.getFoldersByName(n);return it.hasNext()?it.next():p.createFolder(n)}
function editable_(i,email){if(!i)throw new Error('Inspection not found.');if(i.InspectionState!=='In Progress')throw new Error('Inspection is no longer editable.');const started=new Date(i.StartedAt).getTime();if(!started||Date.now()-started>=APP.INSPECTION_TIMEOUT_MS)throw new Error('Inspection expired after 5 minutes. Start it again.');if(norm_(i.UserEmail)!==norm_(email))throw new Error('Inspection belongs to another user.')}
function audit_(email,action,type,id,details){append_(db_().getSheetByName(APP.SHEETS.audit),{EventID:Utilities.getUuid(),Timestamp:new Date(),UserEmail:email,Action:action,EntityType:type,EntityID:id,Details:details||''})}
function db_(){const id=PropertiesService.getScriptProperties().getProperty('CLOSING_SPREADSHEET_ID');if(id)return SpreadsheetApp.openById(id);const active=SpreadsheetApp.getActiveSpreadsheet();if(active)return active;throw new Error('The Apps Script project must be attached to the CLOSING spreadsheet.')}
function rows_(sh){if(!sh||sh.getLastRow()<2)return[];const v=sh.getDataRange().getValues(),h=v.shift().map(String);return v.filter(r=>r.some(x=>x!==''&&x!==null)).map(r=>h.reduce((o,k,i)=>(o[k]=r[i]instanceof Date?r[i].toISOString():r[i],o),{}))}
function rowsTail_(sh,maxRows){if(!sh||sh.getLastRow()<2)return[];const last=sh.getLastRow(),cols=sh.getLastColumn(),start=Math.max(2,last-Number(maxRows||500)+1),h=sh.getRange(1,1,1,cols).getValues()[0].map(String),v=sh.getRange(start,1,last-start+1,cols).getValues();return v.filter(r=>r.some(x=>x!==''&&x!==null)).map(r=>h.reduce((o,k,i)=>(o[k]=r[i]instanceof Date?r[i].toISOString():r[i],o),{}))}
function append_(sh,o){const h=sh.getRange(1,1,1,sh.getLastColumn()).getValues()[0].map(String);sh.appendRow(h.map(k=>Object.prototype.hasOwnProperty.call(o,k)?o[k]:''))}
function update_(sh,key,val,c){const d=sh.getDataRange().getValues(),h=d[0].map(String),kc=h.indexOf(key);for(let r=1;r<d.length;r++)if(String(d[r][kc])===String(val)){let changed=false;Object.keys(c).forEach(k=>{const x=h.indexOf(k);if(x>=0){d[r][x]=c[k];changed=true}});if(changed)sh.getRange(r+1,1,1,h.length).setValues([d[r]]);return true}return false}
function find_(ss,sheet,key,val){return rows_(ss.getSheetByName(sheet)).find(x=>String(x[key])===String(val))}
function user_(e){return rows_(db_().getSheetByName(APP.SHEETS.users)).find(x=>norm_(x.Email)===norm_(e))}
function auth_(t){if(!t)throw new Error('AUTH_REQUIRED');const p=PropertiesService.getScriptProperties(),k='CLOSE_SESSION_'+hash_(t),raw=p.getProperty(k);if(!raw)throw new Error('AUTH_REQUIRED');const s=JSON.parse(raw),u=user_(s.email);if(s.expires<Date.now()||!u||!yes_(u.Active)){p.deleteProperty(k);throw new Error('AUTH_REQUIRED')}s.user=u;return s}
function lock_(f){const l=LockService.getScriptLock();l.waitLock(30000);try{return f()}finally{l.releaseLock()}}
function norm_(v){return String(v||'').trim().toLowerCase()}function yes_(v){return v===true||['TRUE','YES','1'].includes(String(v).toUpperCase())}
function day_(){return Utilities.formatDate(new Date(),'America/New_York','yyyy-MM-dd')}function dateKey_(v){const d=new Date(v);return isNaN(d)?'':Utilities.formatDate(d,'America/New_York','yyyy-MM-dd')}function desc_(a,b){return String(b.CompletedAt||b.StartedAt||'').localeCompare(String(a.CompletedAt||a.StartedAt||''))}
function hash_(v){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(v),Utilities.Charset.UTF_8).map(b=>('0'+((b+256)%256).toString(16)).slice(-2)).join('')}function equal_(a,b){a=String(a||'');b=String(b||'');if(a.length!==b.length)return false;let d=0;for(let i=0;i<a.length;i++)d|=a.charCodeAt(i)^b.charCodeAt(i);return d===0}
function rate_(e){const c=CacheService.getScriptCache(),k='CLOSE_LOGIN_'+hash_(e),n=Number(c.get(k)||0);if(n>=8)throw new Error('Too many attempts. Wait 15 minutes.');c.put(k,String(n+1),900)}